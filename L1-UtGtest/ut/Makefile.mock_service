.PHONY: mock_service

HAL_DIR ?= $(CURDIR)

MOCK_SERVICE_SONAME := videodecoder

MOCK_SERVICE_BIN := VideoDecoderService
MOCK_SERVICE_LIB := lib$(MOCK_SERVICE_SONAME).so

BUILD_DIR ?= $(HAL_DIR)/build

AIDL_GEN_DIR ?= $(BUILD_DIR)/videodecoder_gen/current

MOCK_SERVICE_DIR ?= $(HAL_DIR)/service/src

AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/AVSource.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/PropertyValue.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/Capabilities.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/CodecCapabilities.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/Codec.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/CSDVideoFormat.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/DynamicRange.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/ErrorCode.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/FrameMetadata.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoderController.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoderControllerListener.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoder.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoderEventListener.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/IVideoDecoderManager.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/OperationalMode.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/PixelFormat.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/Property.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/PropertyKVPair.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/videodecoder/ScanType.cpp


MOCK_SERVICE_LIB_SRC := $(AIDL_GEN_SRC)
MOCK_SERVICE_LIB_SRC += $(MOCK_SERVICE_DIR)/VideoDecoder.cpp

MOCK_SERVICE_BIN_SRC := $(MOCK_SERVICE_DIR)/VideoDecoderService.cpp


MOCK_SERVICE_INC_FLAGS := -I$(AIDL_GEN_DIR)/h
MOCK_SERVICE_INC_FLAGS += -I$(BUILD_DIR)/usr/include
MOCK_SERVICE_INC_FLAGS += -I$(MOCK_SERVICE_DIR)

MOCK_SERVICE_LD_LIBS := -lbinder -lutils

MOCK_SERVICE_LDFLAGS := -L$(BUILD_DIR)/usr/lib
MOCK_SERVICE_LDFLAGS += -Wl,-rpath-link=$(BUILD_DIR)/usr/lib

MOCK_SERVICE_CFLAGS := -Wall -Wextra -std=c++17 -ggdb

mock_service: $(MOCK_SERVICE_BIN) $(MOCK_SERVICE_LIB)

$(MOCK_SERVICE_LIB): $(MOCK_SERVICE_LIB_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $^ -o $@ $(MOCK_SERVICE_LD_LIBS)
	install $(MOCK_SERVICE_LIB) $(BUILD_DIR)/usr/lib

$(MOCK_SERVICE_BIN): $(MOCK_SERVICE_LIB)
$(MOCK_SERVICE_BIN): $(MOCK_SERVICE_BIN_SRC:%.cpp=%.o)
	g++ $(MOCK_SERVICE_LDFLAGS) \
		$(MOCK_SERVICE_BIN_SRC:%.cpp=%.o) -o $@ \
		$(MOCK_SERVICE_LD_LIBS) -l$(MOCK_SERVICE_SONAME)
	install $(MOCK_SERVICE_BIN) $(BUILD_DIR)/usr/bin

$(MOCK_SERVICE_BIN_SRC:%.cpp=%.o):$(MOCK_SERVICE_BIN_SRC)
	g++ $(MOCK_SERVICE_CFLAGS) $(MOCK_SERVICE_INC_FLAGS) -c $< -o $@

# TODO: to be compile out of source tree
%.o: %.cpp
	g++ $(MOCK_SERVICE_CFLAGS) $(MOCK_SERVICE_INC_FLAGS) -fPIC -c $< -o $@
